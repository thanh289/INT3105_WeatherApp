{
  "name": "weather-rest-api",
  "version": "1.0.0",
  "description": "A simple weather-rest-api application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "start-production": "node dist/server.js",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "client": "npm start --prefix frontend",
    "test": "mocha --timeout 30000 --require tsx/cjs src/test/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix --ext .ts,.tsx .",
    "prettier": "prettier src/**/*.ts",
    "prettier:fix": "prettier --write src/**/*.ts",
    "watch-ts": "tsc -w"
  },
  "keywords": [
    "node.js",
    "express.js",
    "typescript",
    "redis",
    "API",
    "MongoDB",
    "REST API",
    "Weather API"
  ],
  "author": "Md Sazzadul Islam",
  "license": "ISC",
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/opossum": "^8.1.9",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "axios-retry": "^4.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "express-winston": "^4.2.0",
    "helmet": "^7.1.0",
    "moment": "^2.30.1",
    "mongoose": "^8.0.3",
    "opossum": "^9.0.0",
    "redis": "^4.6.12",
    "winston": "^3.11.0"
  }
}
